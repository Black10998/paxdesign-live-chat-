    "legal.privacy.purpose_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is for authorized staff to handle live chat requests. Only data required for support is processed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App dient autorisierten Mitarbeitern zur Bearbeitung von Live-Chat-Anfragen. Es werden nur Daten verarbeitet, die für den Support erforderlich sind."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق مخصص للموظفين المصرح لهم بمعالجة طلبات الدردشة المباشرة. تُعالج فقط البيانات اللازمة للدعم."
          }
        }
      }
    },
