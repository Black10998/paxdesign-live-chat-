          "stringUnit": {
            "state": "translated",
            "value": "Device token is sent to the WordPress server to signal live requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-Token wird an den WordPress-Server übermittelt, um Live-Anfragen zu signalisieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل رمز الجهاز إلى خادم WordPress للإشارة إلى الطلبات المباشرة."
          }
        }
      }
    },
    "legal.data.deletion_title": {
