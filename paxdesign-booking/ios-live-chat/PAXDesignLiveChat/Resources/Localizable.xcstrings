    "legal.data.deletion_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-out removes local credentials. Server-side deletion via WordPress administration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmeldung entfernt lokale Zugangsdaten. Serverseitige Löschung über WordPress-Administration."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل تسجيل الخروج بيانات الاعتماد المحلية. الحذف من الخادم عبر إدارة WordPress."
          }
        }
      }
    },
    "legal.data.app_store_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store privacy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Privacy"
          }
        },
        "ar": {
          "stringUnit": {
