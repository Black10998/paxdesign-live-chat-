    "language.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply immediately. Arabic uses right-to-left layout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort. Arabisch verwendet Rechts-nach-Links-Layout."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق التغييرات فوراً. تستخدم العربية تخطيطاً من اليمين إلى اليسار."
          }
        }
      }
    },
    "language.spoken.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Languages you speak"
          }
        },
