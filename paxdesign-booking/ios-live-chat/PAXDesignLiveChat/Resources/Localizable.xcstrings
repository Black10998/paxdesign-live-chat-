    "legal.privacy.legal_basis_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Art. 6(1)(b) (contract/support) and (f) (legitimate interest in customer service)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Art. 6 Abs. 1 lit. b (Vertrag/Support) und lit. f (berechtigtes Interesse am Kundenservice)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المادة 6(1)(ب) (العقد/الدعم) و(و) (المصلحة المشروعة في خدمة العملاء)."
          }
        }
      }
    },
