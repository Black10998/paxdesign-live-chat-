    "team.delete_message_all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the conversation and all messages for every participant. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht die Unterhaltung und alle Nachrichten für alle Teilnehmer dauerhaft. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا المحادثة وجميع الرسائل لكل المشاركين نهائياً. لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
    "team.delete_message_remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the conversation from your Team list only. The other participant can still see it unless they also remove it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt die Unterhaltung nur aus Ihrer Team-Liste. Der andere Teilnehmer kann sie weiterhin sehen, sofern er sie nicht ebenfalls entfernt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا المحادثة من قائمة فريقك فقط. يمكن للمشارك الآخر رؤيتها ما لم يزيلها أيضاً."
          }
        }
      }
    },
