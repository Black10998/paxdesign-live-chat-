    "legal.privacy.data_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login credentials (WordPress Application Password, local keychain), chat content, metadata (timestamps, session ID), optional profile image on device, push token for notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten (WordPress Application Password, lokal im Schlüsselbund), Chat-Inhalte, Metadaten (Zeitstempel, Session-ID), optional Profilbild lokal auf dem Gerät, Push-Token für Benachrichtigungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الاعتماد (كلمة مرور تطبيق WordPress، سلسلة مفاتيح محلية)، محتوى المحادثة، البيانات الوصفية (الطوابع الزمنية، معرف الجلسة)، صورة ملف اختيارية على الجهاز، رمز الدفع للإشعارات."
          }
        }
      }
    },
    "legal.privacy.storage_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherung"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخزين"
          }
        }
      }
    },
    "legal.privacy.storage_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat content is stored on the client's WordPress server. Login credentials remain encrypted in the iOS keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Inhalte werden auf dem WordPress-Server des Auftraggebers gespeichert. Anmeldedaten verbleiben verschlüsselt im iOS-Schlüsselbund."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن محتوى المحادثة على خادم WordPress للعميل. تبقى بيانات الاعتماد مشفرة في سلسلة مفاتيح iOS."
          }
        }
      }
    },
    "legal.privacy.transmission_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmission"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übermittlung"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل"
          }
        }
      }
    },
    "legal.privacy.transmission_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All API communication uses HTTPS (TLS). No additional end-to-end encryption beyond transport encryption is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle API-Kommunikation erfolgt über HTTPS (TLS). Es wird keine Ende-zu-Ende-Verschlüsselung zusätzlich zur Transportverschlüsselung eingesetzt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع اتصالات API تستخدم HTTPS (TLS). لا يُستخدم تشفير من طرف إلى طرف إضافي بخلاف تشفير النقل."
          }
        }
      }
    },
    "legal.privacy.legal_basis_title": {
