    "legal.terms.liability_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is provided for internal support operations. Damage from improper use is excluded where legally permitted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird im Rahmen des internen Support-Betriebs bereitgestellt. Schäden durch unsachgemäße Nutzung sind ausgeschlossen, soweit gesetzlich zulässig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقدَّم التطبيق لعمليات الدعم الداخلية. يُستثنى الضرر الناتج عن الاستخدام غير السليم حيث يسمح القانون."
          }
