    "legal.terms.duties_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat chat content confidentially. Do not share credentials. Protect the device with a passcode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Inhalte vertraulich behandeln. Keine Weitergabe von Zugangsdaten. Gerät mit Code schützen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عامل محتوى المحادثة بسرية. لا تشارك بيانات الاعتماد. احمِ الجهاز برمز مرور."
          }
        }
      }
    },
