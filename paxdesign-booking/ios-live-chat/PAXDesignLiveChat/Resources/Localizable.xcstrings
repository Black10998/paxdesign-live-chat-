          }
        }
      }
    },
    "legal.data.app_store_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tracking. Contact information and user content are processed for app functionality."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Tracking. Kontaktinformationen und Benutzerinhalte werden für App-Funktionalität verarbeitet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتبع. تُعالج معلومات الاتصال ومحتوى المستخدم لوظائف التطبيق."
          }
        }
      }
    },
    "help.about_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diese App"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حول هذا التطبيق"
          }
        }
      }
    },
    "help.about_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PAXDesign Live Chat is the official iOS app for authorized staff. It connects securely via HTTPS to your WordPress backend and mirrors the browser live admin panel — optimized for mobile with push notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PAXDesign Live Chat ist die offizielle iOS-App für autorisierte Mitarbeiter. Sie verbindet sich sicher per HTTPS mit Ihrem WordPress-Backend und spiegelt die Funktionen des Browser-Live-Admin-Panels — optimiert für unterwegs und mit Push-Benachrichtigungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PAXDesign Live Chat هو تطبيق iOS الرسمي للموظفين المصرح لهم. يتصل بأمان عبر HTTPS بخادم WordPress ويعكس لوحة الإدارة المباشرة في المتصفح — محسّن للجوال مع إشعارات الدفع."
          }
        }
      }
    },
    "help.login_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in & account"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung & Konto"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول والحساب"
          }
        }
      }
    },
    "help.login_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your website HTTPS URL, WordPress username (or email), and an Application Password. Create the password in WordPress under Users → Profile. After sign-in, credentials remain encrypted in the iOS keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die HTTPS-URL Ihrer Website, Ihren WordPress-Benutzernamen (oder E-Mail) und ein Application Password ein. Das Passwort erstellen Sie in WordPress unter Benutzer → Profil. Nach erfolgreicher Anmeldung bleiben die Zugangsdaten verschlüsselt im iOS-Schlüsselbund."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان HTTPS لموقعك واسم مستخدم WordPress (أو البريد) وكلمة مرور التطبيق. أنشئ كلمة المرور في WordPress ضمن المستخدمون → الملف. بعد تسجيل الدخول تبقى بيانات الاعتماد مشفرة في سلسلة مفاتيح iOS."
          }
        }
      }
    },
    "help.live_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live requests"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Anfragen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات مباشرة"
          }
        }
      }
    },
    "help.live_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a customer requests a live agent, a premium banner and full-screen alert with ringtone appear. Switch to the Live tab to see open requests. Accept or decline — accepted chats open automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Kunde einen Live-Agenten anfordert, erscheint ein Premium-Banner oben in der App sowie ein Vollbild-Alarm mit Klingelton. Wechseln Sie zum Live-Tab, um alle offenen Anfragen zu sehen. Übernehmen oder lehnen Sie Anfragen ab — übernommene Chats öffnen sich automatisch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يطلب عميل وكيلاً مباشراً، يظهر شعار مميز وتنبيه ملء الشاشة مع نغمة رنين. انتقل إلى تبويب Live لرؤية الطلبات المفتوحة. اقبل أو ارفض — تُفتح المحادثات المقبولة تلقائياً."
          }
        }
      }
    },
    "help.chats_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats & messages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats & Nachrichten"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحادثات والرسائل"
          }
        }
      }
    },
    "help.chats_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chats tab shows all active conversations. Use search and filters (All, Live, Open, Active, Closed). Unread customer messages show a badge. Long-press a message: copy, share, or reply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Chats-Tab sehen Sie alle aktiven Gespräche. Nutzen Sie Suche und Filter (Alle, Live, Offen, Aktiv, Geschlossen). Ungelesene Kundennachrichten werden mit einem Badge markiert. Lang drücken auf eine Nachricht: Kopieren, Teilen oder Antworten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض تبويب المحادثات جميع المحادثات النشطة. استخدم البحث والفلاتر. تظهر الرسائل غير المقروءة بشارة. اضغط مطولاً على رسالة: نسخ أو مشاركة أو رد."
          }
        }
      }
    },
    "help.images_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending images"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder senden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الصور"
          }
        }
      }
    },
    "help.images_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the photo icon in the composer to send an image from the library. Images are optimized before upload and shown as previews. Tap an image for full-screen view."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf das Foto-Symbol im Composer, um ein Bild aus der Mediathek zu senden. Bilder werden vor dem Upload optimiert und im Chat als Vorschaubild angezeigt. Tippen Sie auf ein Bild für die Vollbild-Ansicht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أيقونة الصورة في المحرر لإرسال صورة من المكتبة. تُحسَّن الصور قبل الرفع وتُعرض كمعاينات. اضغط على صورة لعرض ملء الشاشة."
          }
        }
      }
    },
    "help.ai_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant & quick replies"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Assistent & Schnellantworten"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساعد الذكاء الاصطناعي والردود السريعة"
          }
        }
      }
    },
    "help.ai_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After customer messages, AI suggestions and quick replies appear above the input field. Tapping fills the text — nothing is sent automatically. Permissions can be restricted by the main administrator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Kundennachrichten erscheinen KI-Vorschläge und Schnellantworten oberhalb des Eingabefelds. Antippen übernimmt den Text — es wird nichts automatisch gesendet. Berechtigungen können vom Hauptadministrator eingeschränkt werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد رسائل العملاء تظهر اقتراحات الذكاء الاصطناعي والردود السريعة فوق حقل الإدخال. النقر يملأ النص — لا يُرسل شيء تلقائياً. يمكن للمسؤول الرئيسي تقييد الصلاحيات."
          }
        }
      }
    },
    "help.notifications_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications & sounds"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen & Töne"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات والأصوات"
          }
        }
      }
    },
    "help.notifications_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push notifications inform about live requests and new messages. In settings you can adjust ringtone, send sound, typing sound, and volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Benachrichtigungen informieren über Live-Anfragen und neue Nachrichten. In den Einstellungen können Klingelton, Sendeton, Tippgeräusch und Lautstärke angepasst werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعلم إشعارات الدفع بطلبات الدعم المباشر والرسائل الجديدة. في الإعدادات يمكنك ضبط نغمة الرنين وصوت الإرسال والكتابة ومستوى الصوت."
          }
        }
      }
    },
    "help.team_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team & permissions"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team & Berechtigungen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفريق والصلاحيات"
          }
        }
      }
    },
    "help.team_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main administrator manages staff access and permissions (view chats, reply, AI, images, settings, ratings, team management, security). Under Account → Team & Permissions or in WordPress admin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptadministrator verwaltet Mitarbeiter-Zugang und Berechtigungen (Chats ansehen, antworten, KI, Bilder, Einstellungen, Bewertungen, Team-Verwaltung, Sicherheit). Unter Konto → Team & Berechtigungen oder im WordPress-Admin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير المسؤول الرئيسي وصول الموظفين والصلاحيات. ضمن الحساب → الفريق والصلاحيات أو في إدارة WordPress."
          }
        }
      }
    },
    "help.privacy_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & security"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz & Sicherheit"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخصوصية والأمان"
          }
        }
      }
    },
    "help.privacy_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All communication uses TLS (HTTPS). There is no end-to-end encryption — messages are stored server-side for support. Email addresses are partially masked in the app. Details under Account → Security and Privacy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kommunikation erfolgt über TLS (HTTPS). Es gibt keine Ende-zu-Ende-Verschlüsselung — Nachrichten werden serverseitig für den Support gespeichert. E-Mail-Adressen werden in der App teilweise maskiert angezeigt. Details unter Konto → Sicherheit und Datenschutz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع الاتصالات تستخدم TLS (HTTPS). لا يوجد تشفير من طرف إلى طرف — تُخزَّن الرسائل على الخادم للدعم. تُخفى عناوين البريد جزئياً في التطبيق. التفاصيل ضمن الحساب → الأمان والخصوصية."
          }
        }
      }
    },
    "help.admin_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best practices for admins"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Practices für Admins"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفضل الممارسات للمسؤولين"
          }
        }
      }
    },
    "help.admin_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out on shared devices. Revoke Application Passwords if lost. Respond promptly to live requests. Use AI suggestions as help and review before sending. Keep plugin and app up to date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich auf gemeinsam genutzten Geräten ab. Widerrufen Sie Application Passwords bei Verlust. Antworten Sie zeitnah auf Live-Anfragen. Nutzen Sie die KI-Vorschläge als Hilfe, prüfen Sie Inhalte vor dem Senden. Halten Sie Plugin und App aktuell."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الخروج على الأجهزة المشتركة. ألغِ كلمات مرور التطبيق عند الفقدان. رد بسرعة على الطلبات المباشرة. استخدم اقتراحات الذكاء الاصطناعي كمساعدة وراجع قبل الإرسال. حدّث الإضافة والتطبيق."
          }
        }
      }
    },
    "help.support_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعم"
          }
        }
      }
    },
    "help.support_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical questions: https://paxdesign.at — Plugin updates are provided automatically via GitHub Releases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische Fragen: https://paxdesign.at — Plugin-Updates werden automatisch über GitHub Releases bereitgestellt."
